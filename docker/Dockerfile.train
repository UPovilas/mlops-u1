# Training image for the K8s Job: prepare -> hpo -> train -> evaluate -> register.
FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv
ARG GIT_COMMIT=uncommitted
ENV SOURCE_GIT_COMMIT=$GIT_COMMIT \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project
COPY params.yaml dvc.yaml ./
COPY data/raw/wine.csv data/raw/wine.csv.dvc data/raw/
COPY src/ src/
RUN useradd --uid 10001 --create-home trainer && mkdir -p models data/processed && chown -R 10001:10001 /app
USER 10001:10001
CMD ["sh", "-c", "python src/prepare.py && python src/hpo.py && python src/train.py && python src/evaluate.py && python src/register.py"]
